# ─── AyurSutra common env template — copy to .env and fill keys ──────────
# cp .env.example .env   (never commit .env)

# ── Shared ──
GROQ_API_KEY=gsk_your_key_here
VITE_GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ── Frontend ──
VITE_API_URL=
# Clerk Frontend API host (instance id), used by the API to verify session JWTs.
# Example: fitting-chicken-5735.clerk.accounts.dev
CLERK_FRONTEND_API=
VITE_APP_NAME=AyurSutra
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx

# Clerk server secret (Phase 2 / CLI — never expose to the browser)
CLERK_SECRET_KEY=sk_test_xxxxxxxx

# ── Backend (Phase 2) ──
BACKEND_PORT=8000
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/ayursutra?charset=utf8mb4
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE_HOURS=24
CORS_ORIGINS=http://localhost:5173
GEMINI_API_KEY=
