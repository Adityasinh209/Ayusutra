# Frontend env lives in the repo-root .env (see ../../.env.example).
# Vite loads it via envDir in vite.config.js.
#
# Required for Clerk sign-in / sign-up:
#   VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
#
# Optional server-only (Phase 2 / Clerk CLI — never prefix with VITE_):
#   CLERK_SECRET_KEY=sk_test_xxxxxxxx
