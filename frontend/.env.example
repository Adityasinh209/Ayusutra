# Vite only exposes keys prefixed with VITE_ to the browser.
# Copy this file to .env.local and fill in values from the Clerk Dashboard
# (API Keys) or by running `clerk env pull` from the frontend directory.

VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx

# Server-only secret. Do NOT prefix with VITE_ — never send this to the client.
# This frontend prototype does not use it. Keep it for Phase 2 / Clerk CLI.
CLERK_SECRET_KEY=sk_test_xxxxxxxx
